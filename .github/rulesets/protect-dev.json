{
  "name": "Protect dev",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/dev"
      ]
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_extra_approval_for_unattributed_changes": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false,
        "required_reviewers": []
      }
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "changelog-bump / Surface growth needs a minor section"
          },
          {
            "context": "ci / Agent-native audit"
          },
          {
            "context": "ci / Completions freshness"
          },
          {
            "context": "ci / Doc build"
          },
          {
            "context": "ci / Fmt, clippy, test"
          },
          {
            "context": "ci / MSRV"
          },
          {
            "context": "ci / Output discipline"
          },
          {
            "context": "ci / Package check"
          },
          {
            "context": "ci / Security audit (advisories)"
          },
          {
            "context": "ci / Security audit (bans licenses sources)"
          },
          {
            "context": "ci / Shellcheck"
          },
          {
            "context": "ci / Windows check"
          },
          {
            "context": "ci / Windows test"
          },
          {
            "context": "ci / Workflow concurrency"
          },
          {
            "context": "ci / macOS test"
          },
          {
            "context": "scope / Change scope"
          }
        ],
        "strict_required_status_checks_policy": false
      }
    },
    {
      "type": "required_linear_history"
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
