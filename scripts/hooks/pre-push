#!/usr/bin/env bash
# Local CI mirror: the whole-repo pre-push gate. Runs the same checks as the
# GitHub Actions CI pipeline, so a push that survives the hook passes CI and a
# push that fails the hook would have failed CI anyway, just slower. CI runs on
# pull_request only, so this is the compensating control for every push, and
# the only remote-equivalent check for code that never opens a PR. Its fast,
# staged-file-scoped companion is scripts/hooks/pre-commit.
#
# Every shared check comes from scripts/hooks/_lib.sh, which both hooks source.
# The two hooks differ in scope, not in what a check means: pre-push passes the
# tracked set, pre-commit passes the staged set. The R20 guard and the Windows
# steps stay inline because pre-commit has no use for them and each carries a
# bird-specific pattern. tests/hook_ci_parity.rs holds every step here against
# the CI job that runs the same check.
#
# Scoped by what the push changes: the Rust battery runs only when a pushed
# path can reach cargo. The scoping fails open: an unrecognized path, a range
# git cannot diff, or a hand-run hook with no ref lines on stdin runs
# everything. The file-level linters always sweep the tracked set; they take
# seconds.
#
# Activate per clone via: git config core.hooksPath scripts/hooks
# core.hooksPath is machine-local git config: it does NOT travel with the
# clone and is not enforced by cloning. Run the command above once per fresh
# clone; CONTRIBUTING.md states it as a setup step.
#
# Defensive no-ops, but never silent: each optional step guards on its tool
# being present and skips cleanly when absent, so the hook never blocks a push
# on a machine without the full toolchain. The library announces every such
# skip, and a skipped check never prints a pass line.
#
# Failures aggregate. One run reports every failing step rather than stopping
# at the first, so a push is fixed in one pass.
#
# Exit codes: 0 = all pass, 1 = failure
#
# Requires bash >= 4.4 (mapfile, and empty-array expansion under `set -u`). The
# guard re-execs under Homebrew's bash when `#!/usr/bin/env bash` found an older
# one, such as the macOS /bin/bash 3.2, and otherwise stops with the install hint.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

# From a linked worktree git exports GIT_DIR, which sends a tool's git calls in
# any directory to this repository: cargo runs `git gc --auto` here after it
# fetches a git dependency, and cargo-deny 0.19.1 through 0.19.5 reset the
# pushed branch during the advisory fetch (fixed in 0.19.6,
# https://github.com/EmbarkStudios/cargo-deny/pull/858). Pre-push has no
# temporary index, and discovery from the hook's cwd (the worktree root) finds
# the same repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1
# shellcheck source=scripts/hooks/_lib.sh
. ./scripts/hooks/_lib.sh || exit 1

fail=0

# ── What this push changes ────────────────────────────────────────────────
#
# git gives a pre-push hook one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# `remote_sha..local_sha` is exactly what the remote does not yet have. A new
# branch arrives with an all-zero remote sha, where the useful comparison is
# against the integration branch instead.
ZERO="0000000000000000000000000000000000000000"
scope_all=false
changed=""

# git writes its ref lines and closes stdin at once, so a real push never
# waits. A plain `$(cat)` would park forever on a stdin nobody closes (a
# background job, a wrapper holding the pipe), so the read is bounded and a
# timeout sweeps.
readonly STDIN_WAIT_SECONDS=10

if [ -t 0 ]; then
  scope_all=true
else
  push_refs=""
  stdin_timed_out=false
  while true; do
    if IFS= read -r -t "$STDIN_WAIT_SECONDS" _line; then
      push_refs+="$_line"$'\n'
    else
      [ $? -gt 128 ] && stdin_timed_out=true
      break
    fi
  done

  if [ "$stdin_timed_out" = true ]; then
    echo "pre-push: stdin stayed open for ${STDIN_WAIT_SECONDS}s with no ref lines; sweeping" >&2
    scope_all=true
    push_refs=""
  fi

  if [ "$scope_all" != true ] && [ -z "$push_refs" ]; then
    # git passes the remote name and URL as arguments. No ref lines while they
    # are present means the remote already has every ref; no arguments at all
    # is a hand-run, which sweeps.
    if [ "$#" -ge 2 ]; then
      echo "pre-push: nothing to push"
      exit 0
    fi
    scope_all=true
  elif [ -n "$push_refs" ]; then
    while read -r _local_ref local_sha _remote_ref remote_sha; do
      [ -z "${local_sha:-}" ] && continue
      # A deletion pushes an all-zero local sha and carries no content.
      [ "$local_sha" = "$ZERO" ] && continue
      if [ "$remote_sha" = "$ZERO" ]; then
        if git rev-parse --verify --quiet origin/dev >/dev/null 2>&1; then
          range="origin/dev...$local_sha"
        else
          scope_all=true
          break
        fi
      else
        range="$remote_sha..$local_sha"
      fi
      if ! range_files=$(git diff --name-only "$range" 2>/dev/null); then
        scope_all=true
        break
      fi
      changed+="$range_files"$'\n'
    done <<<"$push_refs"
  fi
fi

# Paths that cannot change what cargo builds, tests, documents, packages, or
# audits: markdown (no test and no doc comment reads a .md file), the
# gitignored .context/, the license texts, and the .github files no test reads.
# Workflows stay cargo inputs because tests/hook_ci_parity.rs reads them.
# Deliberately narrow: a path wrongly called inert skips the battery.
INERT_RE='(\.md$|^\.context/|^LICENSE-|^\.github/(ISSUE_TEMPLATE/|rulesets/|dependabot\.yml$))'

cargo_changed=""
if ! $scope_all; then
  cargo_changed=$(grep -Ev "$INERT_RE" <<<"$changed" | grep -v '^$' || true)
fi

# code_touched: true unless every changed path is inert.
code_touched() {
  $scope_all && return 0
  [ -n "$cargo_changed" ]
}

banner "Running local CI checks..."
if ! $scope_all; then
  note "scope: $(grep -cv '^$' <<<"$changed") changed path(s) in this push"
fi

# R20: every call site that emits user-visible output uses an injected
# &mut dyn Write writer or an OutputConfig::print_* method, never the bare
# println! family. src/main.rs (the binary shim) and src/error/fatal.rs (the
# fatal-error chokepoint) are the only permitted survivors. The pattern and
# globs are the ones .github/workflows/guard-r20.yml runs.
check_r20() {
  have rg || skip "r20" "install via \`brew install ripgrep\`" || return
  local forbidden
  forbidden=$(rg -n '\b(println|eprintln|print|eprint|out_println|out_print|diag)!' \
    --glob 'src/**/*.rs' \
    --glob '!src/main.rs' \
    --glob '!src/error/fatal.rs' || true)
  [ -z "$forbidden" ] && return 0
  printf '%s\n' "$forbidden" >&2
  return 1
}

# Windows cross-check (fast): no unconditional use of unix-only libc APIs.
# Catches the libc::SIGPIPE class of issue without a Windows toolchain; the
# cross-target clippy below is the comprehensive backstop.
check_windows_libc() {
  have rg || skip "windows compat (libc grep)" "install via \`brew install ripgrep\`" || return
  local violations file lineno before rc=0
  violations=$(rg -n 'libc::(SIGPIPE|SIG_DFL|signal)' --type rust src/ 2>/dev/null || true)
  [ -n "$violations" ] || return 0
  while IFS= read -r line; do
    file=${line%%:*}
    lineno=$(echo "$line" | cut -d: -f2)
    before=$(sed -n "$((lineno > 3 ? lineno - 3 : 1)),${lineno}p" "$file")
    # Here-string, not a pipe: `rg -q` exits at its first match, and under
    # `pipefail` that kills the producer and makes a *matching* pipeline
    # non-zero, which this `!` would read as "no cfg(unix) found".
    if ! rg -q 'cfg\(unix\)' <<<"$before"; then
      step_failed "libc unix-only API used without #[cfg(unix)] at $file:$lineno"
      rc=1
    fi
  done <<<"$violations"
  return "$rc"
}

# Windows cross-clippy: a full type-check as if compiling for
# x86_64-pc-windows-gnu, which surfaces the cfg-gated unused imports and dead
# code Linux clippy filters out. Needs `mingw-w64` and
# `rustup target add x86_64-pc-windows-gnu`; without them CI's Windows job is
# the only backstop.
check_windows_clippy() {
  have x86_64-w64-mingw32-gcc \
    && grep -q '^x86_64-pc-windows-gnu$' <<<"$(rustup target list --installed 2>/dev/null)" \
    || skip "windows clippy (cross-target)" \
      "install \`mingw-w64\` + \`rustup target add x86_64-pc-windows-gnu\`" || return
  cargo clippy --target x86_64-pc-windows-gnu --all-targets --quiet -- -D warnings 2>&1
}

# ── Rust battery ──────────────────────────────────────────────────────────
if code_touched; then
  show_toolchain

  # Steps that take the cargo build lock run serially: together they would
  # serialize on the lock anyway and interleave their output.
  step "fmt" "cargo fmt -- --check" check_cargo_fmt || fail=1
  step "clippy" "cargo clippy --all-targets -- -D warnings" check_clippy --all-targets || fail=1
  step "test" "cargo test" check_tests || fail=1
  msrv=$(msrv_version)
  step "msrv${msrv:+ ($msrv)}" "cargo +${msrv:-MSRV} check" check_msrv || fail=1
  step "doc" "cargo doc --no-deps (RUSTDOCFLAGS=-D warnings)" check_doc || fail=1
  step "deny" "cargo deny check" check_deny || fail=1
  step "r20" "forbidden output macro in src/; use an injected writer or OutputConfig method" check_r20 || fail=1
  step "windows compat (libc grep)" "unix-only libc API outside #[cfg(unix)]" check_windows_libc || fail=1
  step "windows clippy (cross-target)" "cargo clippy --target x86_64-pc-windows-gnu -- -D warnings" \
    check_windows_clippy || fail=1
else
  note "rust battery (nothing in this push reaches cargo)"
fi

# ── File-level linters, over the tracked set ──────────────────────────────
# None takes a lock and each only reads files, so they run together and the
# slowest sets their wall-clock.
step_bg "shellcheck" "shellcheck --severity=warning" check_shell_all
step_bg "shfmt" "shfmt -i 2 -ci -bn -d" check_shfmt_all
step_bg "actionlint" "actionlint" check_actionlint_all
step_bg "concurrency namespacing" "scripts/check-workflow-concurrency.sh" check_workflow_concurrency_all
step_bg "core-env guard" "scripts/hooks/core-env-guard.sh" check_core_env_all
step_wait || fail=1

[ "$fail" -eq 0 ] || {
  echo "pre-push checks failed; rerun the command each failure names." >&2
  exit 1
}

banner "All checks passed."
