
use builtin;
use str;

set edit:completion:arg-completer[bird] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'bird'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'bird'= {
            cand -u 'Signed-in account to use when the app holds tokens for several (as `xr -u`)'
            cand --username 'Signed-in account to use when the app holds tokens for several (as `xr -u`)'
            cand -o 'Output format (text, json, jsonl, ndjson). Defaults to json when piped'
            cand --output 'Output format (text, json, jsonl, ndjson). Defaults to json when piped'
            cand --color 'Color mode: auto (default), always, never'
            cand --timeout 'Network timeout in seconds (default 30) for each X API request'
            cand --limit 'Maximum number of results to return on list-style commands (default 100, ceiling 1000)'
            cand --cursor 'Pagination cursor token for list-style commands (X API `pagination_token`/`next_token`)'
            cand --app 'App in the token store to use. `--app` wins over `BIRD_APP`, which wins over the store''s default app. bird does not read `XURL_APP`; when it is set and `BIRD_APP` is not, commands that call the X API print a warning'
            cand --auth 'Per-call auth scheme override: `app`, `oauth1`, `oauth2`, or `none`. `none` is refused for a command whose X API endpoint requires authentication'
            cand --json 'Shorthand for `--output json`'
            cand --jsonl 'Shorthand for `--output jsonl`'
            cand -q 'Suppress informational stderr output (keep only fatal errors)'
            cand --quiet 'Suppress informational stderr output (keep only fatal errors)'
            cand -v 'Increase verbosity (repeatable: -v info, -vv debug, -vvv trace)'
            cand --verbose 'Increase verbosity (repeatable: -v info, -vv debug, -vvv trace)'
            cand --no-interactive 'Disable interactive prompts (refuse anything that would block on stdin)'
            cand --raw 'Emit unstyled, compact output: pipe-safe text, and `json` on one line'
            cand --examples 'Print curated examples block and exit'
            cand --refresh 'Send every read instead of answering it from a stored response; still store the reply'
            cand --no-cache 'Read and write no stored responses, notes, or ledger records'
            cand --cache-only 'Answer only from stored responses; never make API requests'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand login 'Authenticate via xurl (OAuth2 PKCE browser flow)'
            cand me 'Show current user (GET /2/users/me)'
            cand bookmarks 'List bookmarks for the current user (paginated, max_results=100)'
            cand profile 'Look up a user profile by username'
            cand search 'Search recent tweets (GET /2/tweets/search/recent)'
            cand thread 'Reconstruct a conversation thread from a post'
            cand watchlist 'Monitor users: check recent activity, manage watchlist'
            cand spend 'Show the local spend ledger: estimated API cost per call'
            cand tweet 'Post a tweet (via xurl)'
            cand reply 'Reply to a tweet (via xurl)'
            cand like 'Like a tweet (via xurl)'
            cand unlike 'Unlike a tweet (via xurl)'
            cand repost 'Repost (retweet) a tweet (via xurl)'
            cand unrepost 'Undo a repost (via xurl)'
            cand follow 'Follow a user (via xurl)'
            cand unfollow 'Unfollow a user (via xurl)'
            cand dm 'Send a direct message (via xurl)'
            cand block 'Block a user (via xurl)'
            cand unblock 'Unblock a user (via xurl)'
            cand mute 'Mute a user (via xurl)'
            cand unmute 'Unmute a user (via xurl)'
            cand doctor 'Show what is available: the X API client, auth, commands, and the file store'
            cand cache 'Report the file store and clear its stored responses'
            cand completions 'Generate shell completions'
            cand skill 'Manage the bird agent-skill bundle (clone from brettdavies/bird-skill into a host''s skills dir)'
            cand schema 'Print the JSON Schema of a command''s output, or of the envelope'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
