{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bird spend",
  "description": "The ok document `bird spend` prints under --output json: the local ledger of API calls and estimated cost over a window, with X's actual figures under `comparison` after `--sync`.",
  "type": "object",
  "required": [
    "status",
    "since",
    "until",
    "summary",
    "daily",
    "top_endpoints",
    "sync_status"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "since": {
      "type": "string",
      "description": "Start of the window (YYYY-MM-DD)."
    },
    "until": {
      "type": "string",
      "description": "End of the window (YYYY-MM-DD)."
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "top_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": true
    },
    "per_app": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "skipped"
      ]
    }
  },
  "additionalProperties": false
}
