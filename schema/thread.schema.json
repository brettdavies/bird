{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bird thread",
  "description": "The ok document `bird thread <post_id>` prints under --output json: the reconstructed conversation in order, root first, each post with its `depth`.",
  "type": "object",
  "required": [
    "status",
    "data",
    "meta"
  ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "depth"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "author_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "post_count": {
          "type": "integer"
        },
        "pages_fetched": {
          "type": "integer"
        },
        "complete": {
          "type": "boolean"
        },
        "root_post_age_days": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
