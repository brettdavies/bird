{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bird doctor payload",
  "description": "The ok document `bird doctor` prints under --output json: `status` beside the fields of the `DoctorReport` struct in src/doctor.rs: embedded X API client status, per-app auth state with presence-only credential reporting, per-command accepted/credentialed scheme matrix, and the file store's locations.",
  "type": "object",
  "required": ["status", "xdk", "auth", "commands", "cache"],
  "properties": {
    "status": {
      "const": "ok"
    },
    "xdk": {
      "type": "object",
      "description": "The embedded X API client (xdk-rs): the linked version and whether the client was built.",
      "required": ["available"],
      "properties": {
        "version": {
          "type": ["string", "null"],
          "description": "Version of the xdk-rs crate linked into this bird build."
        },
        "available": {
          "type": "boolean",
          "description": "Whether the embedded client was built. When false, every API command is unavailable and `reason` names the construction error."
        },
        "reason": {
          "type": "string",
          "description": "Why the embedded client could not be built. Present only when `available` is false."
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "Per-app credential snapshot keyed by app name plus a separate `env` block for `CLIENT_ID` / `CLIENT_SECRET` / `XURL_BEARER_TOKEN` env-var presence. Every credential surface is reported as a boolean presence flag; no token material reaches the report.",
      "required": ["active_app", "apps", "env"],
      "properties": {
        "active_app": {
          "type": "string",
          "description": "App used when `--app NAME` is not supplied."
        },
        "apps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["client_id_set", "client_secret_set", "oauth2_tokens"],
            "properties": {
              "client_id_set": { "type": "boolean" },
              "client_secret_set": { "type": "boolean" },
              "default_user": {
                "type": "string",
                "description": "Username the client picks when no `-u NAME` is supplied for this app."
              },
              "oauth2_tokens": {
                "type": "object",
                "description": "Per-user OAuth2 token presence map. Keys are usernames; values describe access/refresh token presence only.",
                "additionalProperties": {
                  "type": "object",
                  "required": ["access_token_present", "refresh_token_present"],
                  "properties": {
                    "access_token_present": { "type": "boolean" },
                    "refresh_token_present": { "type": "boolean" }
                  }
                }
              },
              "unnamed_oauth2": {
                "type": "object",
                "required": ["access_token_present", "refresh_token_present"],
                "properties": {
                  "access_token_present": { "type": "boolean" },
                  "refresh_token_present": { "type": "boolean" }
                }
              },
              "oauth1": {
                "type": "object",
                "required": [
                  "access_token_present",
                  "token_secret_present",
                  "consumer_key_present",
                  "consumer_secret_present"
                ],
                "properties": {
                  "access_token_present": { "type": "boolean" },
                  "token_secret_present": { "type": "boolean" },
                  "consumer_key_present": { "type": "boolean" },
                  "consumer_secret_present": { "type": "boolean" }
                }
              },
              "bearer": {
                "type": "object",
                "required": ["token_present"],
                "properties": {
                  "token_present": { "type": "boolean" }
                }
              }
            }
          }
        },
        "env": {
          "type": "object",
          "required": ["client_id_set", "client_secret_set", "bearer_token_set"],
          "properties": {
            "client_id_set": { "type": "boolean" },
            "client_secret_set": { "type": "boolean" },
            "bearer_token_set": { "type": "boolean" }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "description": "Per-command availability keyed by subcommand name.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "available",
          "accepted_schemes",
          "credentialed_schemes",
          "reachable"
        ],
        "properties": {
          "available": { "type": "boolean" },
          "reason": {
            "type": "string",
            "description": "Human-readable reason a command is unavailable (e.g. \"not authenticated\")."
          },
          "accepted_schemes": {
            "type": "array",
            "items": { "type": "string", "enum": ["app", "oauth1", "oauth2"] },
            "description": "Auth schemes the X API endpoint accepts, from `xdk::api::auth_matrix::supported_auth`. Empty for commands with no fixed endpoint: `login`, the raw HTTP verbs, and local watchlist edits."
          },
          "credentialed_schemes": {
            "type": "array",
            "items": { "type": "string", "enum": ["app", "oauth1", "oauth2"] },
            "description": "Subset of `accepted_schemes` for which the active app has a stored credential."
          },
          "reachable": {
            "type": "boolean",
            "description": "True when `accepted_schemes` intersects `credentialed_schemes` and the embedded client is available. Single load-bearing bit agents key on."
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "description": "The file store: the archive, the response files, and the spend ledger, the same object `bird cache stats` prints.",
      "required": [
        "archive",
        "responses",
        "ledger",
        "healthy"
      ],
      "properties": {
        "archive": {
          "type": "object",
          "description": "The Markdown archive.",
          "required": [
            "path",
            "exists",
            "source",
            "writable",
            "posts",
            "users",
            "bookmarks",
            "likes",
            "size_mb"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "The archive directory."
            },
            "exists": {
              "type": "boolean",
              "description": "Whether the location exists yet."
            },
            "source": {
              "enum": [
                "default",
                "config",
                "env"
              ],
              "description": "Which input chose the archive directory: the default, `archive_dir` in config.toml, or `BIRD_ARCHIVE_DIR`."
            },
            "writable": {
              "type": "boolean",
              "description": "Whether bird can write the directory, or its nearest existing ancestor when it does not exist."
            },
            "posts": {
              "type": "integer",
              "minimum": 0,
              "description": "Notes under `posts/`."
            },
            "users": {
              "type": "integer",
              "minimum": 0,
              "description": "Notes under `users/`."
            },
            "bookmarks": {
              "type": "integer",
              "minimum": 0,
              "description": "Notes under `bookmarks/`."
            },
            "likes": {
              "type": "integer",
              "minimum": 0,
              "description": "Notes under `likes/`."
            },
            "size_mb": {
              "type": "number",
              "description": "Total size of bird's notes, in MB."
            }
          },
          "additionalProperties": false
        },
        "responses": {
          "type": "object",
          "description": "The per-account response files.",
          "required": [
            "path",
            "exists",
            "writable",
            "files",
            "fresh",
            "size_mb"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "The response files directory."
            },
            "exists": {
              "type": "boolean",
              "description": "Whether the location exists yet."
            },
            "writable": {
              "type": "boolean",
              "description": "Whether bird can write the directory, or its nearest existing ancestor when it does not exist."
            },
            "files": {
              "type": "integer",
              "minimum": 0,
              "description": "Stored response files."
            },
            "fresh": {
              "type": "integer",
              "minimum": 0,
              "description": "Response files written today (UTC), which still answer requests."
            },
            "size_mb": {
              "type": "number",
              "description": "Total size of the response files, in MB."
            }
          },
          "additionalProperties": false
        },
        "ledger": {
          "type": "object",
          "description": "The spend ledger.",
          "required": [
            "path",
            "exists",
            "size_mb"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "The spend ledger file."
            },
            "exists": {
              "type": "boolean",
              "description": "Whether the location exists yet."
            },
            "size_mb": {
              "type": "number",
              "description": "Size of the ledger, in MB."
            }
          },
          "additionalProperties": false
        },
        "healthy": {
          "type": "boolean",
          "description": "True when the archive, the responses directory, and the ledger's directory are all writable."
        }
      },
      "additionalProperties": false
    },
    "linked_xdk_version": {
      "type": "string",
      "description": "Version of the xdk-rs crate linked into this bird build."
    }
  },
  "additionalProperties": false
}
